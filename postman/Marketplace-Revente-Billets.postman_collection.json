{
  "info": {
    "_postman_id": "3fdb1fc0-57e4-4cbc-a4cb-2d8a7715a4ea",
    "name": "Marketplace Revente Billets API",
    "description": "Collection de validation fonctionnelle pour la marketplace de revente de billets (catalogue, listings, commandes, waitlist, webhook).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "RUN - Parcours Evaluatrice",
      "description": "Parcours conseille en Collection Runner: 1) creer listing, 2) uploader le ticket (PDF), 3) certifier, 4) commander, 5) verifier commande, 6) marquer payee ou webhook, 7) webhook idempotent.",
      "item": [
        {
          "name": "1. Create listing (CLIENT)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwtSeller}}", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"eventId\": \"{{eventId}}\",\n  \"price\": 89.00,\n  \"currency\": \"EUR\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/listings",
              "host": ["{{baseUrl}}"],
              "path": ["api", "listings"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', function () { pm.response.to.have.status(201); });",
                  "var json = pm.response.json();",
                  "pm.test('listing id present', function () { pm.expect(json.id).to.be.ok; });",
                  "pm.collectionVariables.set('listingId', json.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "2. Upload ticket PDF (CLIENT)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwtSeller}}", "type": "text" }
            ],
            "body": {
              "mode": "formdata",
              "formdata": [
                { "key": "file", "type": "file", "src": "" }
              ]
            },
            "url": {
              "raw": "{{baseUrl}}/api/listings/{{listingId}}/attachments",
              "host": ["{{baseUrl}}"],
              "path": ["api", "listings", "{{listingId}}", "attachments"]
            }
          }
        },
        {
          "name": "3. Certify listing (CONTROLLER)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwtController}}", "type": "text" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/certification/{{listingId}}/certify",
              "host": ["{{baseUrl}}"],
              "path": ["api", "certification", "{{listingId}}", "certify"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', function () { pm.response.to.have.status(200); });",
                  "var json = pm.response.json();",
                  "pm.test('status CERTIFIED', function () { pm.expect(json.status).to.eql('CERTIFIED'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "4. Place order (CLIENT acheteur)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{jwtBuyer}}", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"listingId\": \"{{listingId}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/orders",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('201 Created', function () { pm.response.to.have.status(201); });",
                  "var json = pm.response.json();",
                  "pm.test('order id present', function () { pm.expect(json.orderId).to.be.ok; });",
                  "pm.collectionVariables.set('orderId', json.orderId);"
                ]
              }
            }
          ]
        },
        {
          "name": "5. Get order",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwtBuyer}}", "type": "text" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/orders/{{orderId}}",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders", "{{orderId}}"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', function () { pm.response.to.have.status(200); });",
                  "var json = pm.response.json();",
                  "pm.test('pricing present', function () { pm.expect(json.pricing).to.be.ok; });"
                ]
              }
            }
          ]
        },
        {
          "name": "6. Mark order paid (CONTROLLER)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{jwtController}}", "type": "text" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/orders/{{orderId}}/pay",
              "host": ["{{baseUrl}}"],
              "path": ["api", "orders", "{{orderId}}", "pay"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK', function () { pm.response.to.have.status(200); });",
                  "var json = pm.response.json();",
                  "pm.test('status PAID', function () { pm.expect(json.status).to.eql('PAID'); });"
                ]
              }
            }
          ]
        },
        {
          "name": "7. Webhook PAID retry (idempotence)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "X-Payment-Webhook-Token", "value": "{{paymentWebhookToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": \"{{orderId}}\",\n  \"status\": \"PAID\",\n  \"providerTransactionId\": \"tx_eval_retry\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/payments/webhooks",
              "host": ["{{baseUrl}}"],
              "path": ["api", "payments", "webhooks"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('200 OK or 202 Accepted', function () {",
                  "  pm.expect([200, 202]).to.include(pm.response.code);",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
